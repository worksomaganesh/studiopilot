# StudioPilot Environment Configuration
# Copy this file to .env.local and populate the secrets.
# DO NOT commit .env.local to version control.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------------------------
# 1. Single Administrator Security Provisioning
# -------------------------------------------------------------
# StudioPilot has exactly ONE administrator account.
# No public registration or sign-up endpoints are exposed.
ADMIN_EMAIL=admin@studiopilot.io
# A strong default session secret for signed tokens / cookies
AUTH_SESSION_SECRET=studio_pilot_super_secure_session_secret_change_me_in_prod_min_32_chars

# -------------------------------------------------------------
# 2. Supabase Configuration (Database & Auth)
# -------------------------------------------------------------
# Create a Supabase project at https://supabase.com
# Execute supabase/migrations/20261123_initial_schema.sql in the SQL Editor.
# Run supabase/seed.sql to seed the initial brand configurations and patterns.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------------------------------------------
# 3. AI Model Provider (Gemini API)
# -------------------------------------------------------------
# StudioPilot uses Google Gemini via an extensible provider abstraction.
# Get an API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -------------------------------------------------------------
# 4. Web Search Provider (Research Studio)
# -------------------------------------------------------------
# Options: tavily | serper | duckduckgo | direct
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

# -------------------------------------------------------------
# 5. Local Development Fallback
# -------------------------------------------------------------
# When set to true and Supabase credentials are not configured,
# StudioPilot automatically uses resilient local file-backed persistence
# so you can run, test and review every feature immediately offline.
ENABLE_LOCAL_STORAGE_FALLBACK=true
